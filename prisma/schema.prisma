generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
  UNLIMITED
}

enum BookStatus {
  DRAFT
  OUTLINING
  GENERATING
  COMPLETED
  FAILED
  PAUSED
}

enum ChapterStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum GenerationJobStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AudioDerivativeType {
  AUDIOBOOK
  PODCAST
  MUSIC
  SONG
}

enum AudioDerivativeStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  plan             Plan      @default(FREE)
  pagesUsed        Int       @default(0)
  pagesLimit       Int       @default(50)
  audioMinutesUsed Int       @default(0)
  audioMinutesLimit Int      @default(0)
  /// One-time purchased page credits (added on top of plan base)
  pagesBonus       Int       @default(0)
  /// One-time purchased audio minutes (added on top of plan base)
  audioMinutesBonus Int      @default(0)
  /// Premium free-trial window; null when not on a trial
  trialEndsAt      DateTime?
  trialStartedAt   DateTime?
  /// One Premium trial per account
  hasUsedPremiumTrial Boolean @default(false)
  /// Set when we email the user ~24h before trialEndsAt
  trialReminderSentAt DateTime?
  stripeCustomerId String?   @unique
  stripeSubId      String?

  // Writing defaults
  defaultGenre         String  @default("Fiction")
  defaultTone          String  @default("Professional")
  defaultAudience      String  @default("General readers")
  defaultTargetPages        Int     @default(10)
  defaultPov           String  @default("third")
  defaultTense         String  @default("past")
  defaultLanguage      String  @default("en")
  defaultModel         String  @default("llama-3.3")
  defaultCreativity    Float   @default(0.7)
  defaultWordsPerPage  Int     @default(300)
  defaultSectionsPerChapter Int @default(4)
  styleGuide           String? @db.Text
  autoGenerateOnCreate Boolean @default(true)
  emailNotifications   Boolean @default(true)
  /// Mobile push for book generation progress + completion
  pushNotifications    Boolean @default(true)

  // Branding / publisher identity
  brandName            String?
  brandTagline         String?
  authorName           String?
  imprintName          String?
  websiteUrl           String?
  brandColor           String  @default("#635bff")
  logoUrl              String?
  copyrightNotice      String? @db.Text
  dedicationDefault    String? @db.Text
  exportFooter         String? @db.Text
  includeBrandInExport Boolean @default(true)

  /// ISO 3166-1 alpha-2 from CDN/geo headers (e.g. NP, US)
  countryCode      String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  books    Book[]
  pushTokens DevicePushToken[]
  bookFeedbacks BookFeedback[]
}

/// FCM device tokens for mobile push notifications
model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id              String     @id @default(cuid())
  userId          String
  /// Unique public identifier used in SEO URLs (/books/[slug])
  slug            String     @unique
  /// Public by default; only Pro/Enterprise can set private
  isPublic        Boolean    @default(true)
  title           String
  description     String?    @db.Text
  genre           String?
  targetPages     Int        @default(100)
  currentPages    Int        @default(0)
  status          BookStatus @default(DRAFT)
  outline         Json?
  style           String?    @db.Text
  audience        String?
  tone            String?
  errorMessage    String?    @db.Text
  progress        Float      @default(0)

  // Advanced generation settings
  pov                 String  @default("third")
  tense               String  @default("past")
  language            String  @default("en")
  chapterCount        Int?
  sectionsPerChapter  Int     @default(4)
  wordsPerPage        Int     @default(300)
  includeDialogue     Boolean @default(true)
  includeExamples     Boolean @default(false)
  customInstructions  String? @db.Text
  characters          Json?
  themes              Json?
  forbiddenTopics     String? @db.Text
  model               String  @default("llama-3.3")
  creativity          Float   @default(0.7)
  templateId          String?
  coverImage          String? @db.Text
  coverPrompt         String? @db.Text
  /// When true, start audiobook narration after the manuscript completes
  generateAudiobookOnComplete Boolean @default(false)

  /// Edition lineage — first book has edition 1; forks share parentBookId
  edition             Int     @default(1)
  parentBookId        String?
  parentBook          Book?   @relation("BookEditions", fields: [parentBookId], references: [id], onDelete: SetNull)
  editions            Book[]  @relation("BookEditions")

  /// Client that created the book: ios | android | web | unknown
  createdVia      String     @default("web")

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  completedAt     DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters        Chapter[]
  generationJobs  GenerationJob[]
  audios          BookAudio[]
  feedbacks       BookFeedback[]
  bible           BookBible?
  storyState      StoryState?
  canonFacts      CanonFact[]

  @@index([userId])
  @@index([status])
  @@index([isPublic])
  @@index([parentBookId])
  @@index([createdVia])
}

/// Permanent canon layer (Book Bible) — authoritative vs manuscript prose.
model BookBible {
  id          String   @id @default(cuid())
  bookId      String   @unique
  /// Narrative style / voice notes
  styleNotes  String?  @db.Text
  /// World / magic / tech rules
  worldRules  String?  @db.Text
  themes      Json?
  /// Unresolved mysteries / open lore
  mysteries   Json?
  /// Extra structured canon bag
  meta        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  book        Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  characters  BibleCharacter[]
  locations   BibleLocation[]
  factions    BibleFaction[]
  objects     BibleObject[]
}

model BibleCharacter {
  id            String   @id @default(cuid())
  bibleId       String
  name          String
  aliases       Json?
  profile       String?  @db.Text
  relationships Json?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bible BookBible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@index([bibleId])
  @@index([bibleId, name])
}

model BibleLocation {
  id          String   @id @default(cuid())
  bibleId     String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bible BookBible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@index([bibleId])
  @@index([bibleId, name])
}

model BibleFaction {
  id          String   @id @default(cuid())
  bibleId     String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bible BookBible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@index([bibleId])
}

model BibleObject {
  id          String   @id @default(cuid())
  bibleId     String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bible BookBible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@index([bibleId])
}

/// Live plot / arc state for the whole book.
model StoryState {
  id             String   @id @default(cuid())
  bookId         String   @unique
  plotPhase      String?
  timelineCursor String?
  openThreads    Json?
  arcs           Json?
  partSummary    String?  @db.Text
  bookSummary    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

/// Explicit canon facts for consistency checking.
model CanonFact {
  id              String   @id @default(cuid())
  bookId          String
  subject         String
  predicate       String
  object          String   @db.Text
  /// CANON | PROVISIONAL | RETCONNED
  status          String   @default("CANON")
  sourceChapterId String?
  sourceSectionId String?
  confidence      Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([bookId, subject])
  @@index([bookId, status])
}

/// User review / complaint after generation (or manual report from book page)
model BookFeedback {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  /// 1–5 stars; null when it's a complaint-only report
  rating    Int?
  /// happy | ok | disappointed | complaint
  sentiment String
  /// completed | failed | manual
  trigger   String
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
  @@index([createdAt])
  @@index([sentiment])
}

model BookAudio {
  id           String                @id @default(cuid())
  bookId       String
  type         AudioDerivativeType
  status       AudioDerivativeStatus @default(PENDING)
  progress     Float                 @default(0)
  title        String?
  voiceId      String?
  voiceName    String?
  /// ElevenLabs voice_settings + modelId JSON
  voiceSettings Json?
  /// Full-track URL when a single file is produced (e.g. music theme)
  audioUrl     String?               @db.Text
  errorMessage String?               @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  completedAt  DateTime?

  book   Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tracks BookAudioTrack[]

  @@index([bookId])
  @@index([bookId, type])
  @@index([status])
}

model BookAudioTrack {
  id        String   @id @default(cuid())
  audioId   String
  number    Int
  title     String
  audioUrl  String   @db.Text
  chapterId String?
  durationMs Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audio BookAudio @relation(fields: [audioId], references: [id], onDelete: Cascade)

  @@unique([audioId, number])
  @@index([audioId])
}

model Chapter {
  id          String        @id @default(cuid())
  bookId      String
  number      Int
  title       String
  summary     String?       @db.Text
  content     String?       @db.Text
  pageCount   Int           @default(0)
  status      ChapterStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  book        Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sections    Section[]
  state       ChapterState?

  @@unique([bookId, number])
  @@index([bookId])
}

/// Compact chapter state for hierarchical context (~300–800 tokens).
model ChapterState {
  id                 String   @id @default(cuid())
  chapterId          String   @unique
  summary            String?  @db.Text
  charactersPresent  Json?
  location           String?
  events             Json?
  newFacts           Json?
  openThreads        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model Section {
  id          String   @id @default(cuid())
  chapterId   String
  number      Int
  title       String
  content     String?  @db.Text
  pageCount   Int      @default(0)
  wordCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  state       SectionState?

  @@unique([chapterId, number])
  @@index([chapterId])
}

/// Compact scene/section state for hierarchical context (~100–200 tokens).
model SectionState {
  id                String   @id @default(cuid())
  sectionId         String   @unique
  summary           String?  @db.Text
  objective         String?  @db.Text
  charactersPresent Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model GenerationJob {
  id          String              @id @default(cuid())
  bookId      String
  type        String
  status      GenerationJobStatus @default(PENDING)
  payload     Json?
  result      Json?
  error       String?             @db.Text
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(3)
  /// Queue priority — higher value runs first (Enterprise > Pro > Free)
  priority    Int                 @default(1)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  book        Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([status, priority, createdAt])
}
