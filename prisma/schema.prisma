generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
  UNLIMITED
}

enum BookStatus {
  DRAFT
  OUTLINING
  GENERATING
  COMPLETED
  FAILED
  PAUSED
}

enum ChapterStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum GenerationJobStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AudioDerivativeType {
  AUDIOBOOK
  PODCAST
  MUSIC
  SONG
}

enum AudioDerivativeStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum ReelFormat {
  /// One 60–90 s reel per chapter
  SHORTS
  /// The whole book in about a minute
  TRAILER
  /// Illustrates an existing audiobook (Premium)
  AUDIOBOOK
}

enum ReelStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  plan             Plan      @default(FREE)
  pagesUsed        Int       @default(0)
  pagesLimit       Int       @default(50)
  audioMinutesUsed Int       @default(0)
  audioMinutesLimit Int      @default(0)
  /// One-time purchased page credits (added on top of plan base)
  pagesBonus       Int       @default(0)
  /// One-time purchased audio minutes (added on top of plan base)
  audioMinutesBonus Int      @default(0)
  /// Premium free-trial window; null when not on a trial
  trialEndsAt      DateTime?
  trialStartedAt   DateTime?
  /// One Premium trial per account
  hasUsedPremiumTrial Boolean @default(false)
  /// Set when we email the user ~24h before trialEndsAt
  trialReminderSentAt DateTime?
  stripeCustomerId String?   @unique
  stripeSubId      String?

  // Writing defaults
  defaultGenre         String  @default("Fiction")
  defaultTone          String  @default("Professional")
  defaultAudience      String  @default("General readers")
  defaultTargetPages        Int     @default(10)
  defaultPov           String  @default("third")
  defaultTense         String  @default("past")
  defaultLanguage      String  @default("en")
  defaultModel         String  @default("llama-3.3")
  defaultCreativity    Float   @default(0.7)
  defaultWordsPerPage  Int     @default(300)
  defaultSectionsPerChapter Int @default(4)
  styleGuide           String? @db.Text
  autoGenerateOnCreate Boolean @default(true)
  emailNotifications   Boolean @default(true)
  /// Mobile push for book generation progress + completion
  pushNotifications    Boolean @default(true)

  // Branding / publisher identity
  brandName            String?
  brandTagline         String?
  authorName           String?
  imprintName          String?
  websiteUrl           String?
  brandColor           String  @default("#635bff")
  logoUrl              String?
  copyrightNotice      String? @db.Text
  dedicationDefault    String? @db.Text
  exportFooter         String? @db.Text
  includeBrandInExport Boolean @default(true)

  /// ISO 3166-1 alpha-2 from CDN/geo headers (e.g. NP, US)
  countryCode      String?

  /// Where the account was created: phone (app) | pc (website) | unknown
  signupVia        String    @default("unknown")

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  books    Book[]
  pushTokens DevicePushToken[]
  bookFeedbacks BookFeedback[]
  reels    StoryReel[]
}

/// FCM device tokens for mobile push notifications
model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id              String     @id @default(cuid())
  userId          String
  /// Unique public identifier used in SEO URLs (/books/[slug])
  slug            String     @unique
  /// Public by default; only Pro/Enterprise can set private
  isPublic        Boolean    @default(true)
  title           String
  description     String?    @db.Text
  genre           String?
  targetPages     Int        @default(100)
  currentPages    Int        @default(0)
  status          BookStatus @default(DRAFT)
  outline         Json?
  style           String?    @db.Text
  audience        String?
  tone            String?
  errorMessage    String?    @db.Text
  progress        Float      @default(0)

  // Advanced generation settings
  pov                 String  @default("third")
  tense               String  @default("past")
  language            String  @default("en")
  chapterCount        Int?
  sectionsPerChapter  Int     @default(4)
  wordsPerPage        Int     @default(300)
  includeDialogue     Boolean @default(true)
  includeExamples     Boolean @default(false)
  customInstructions  String? @db.Text
  characters          Json?
  themes              Json?
  forbiddenTopics     String? @db.Text
  model               String  @default("llama-3.3")
  creativity          Float   @default(0.7)
  templateId          String?
  coverImage          String? @db.Text
  coverPrompt         String? @db.Text
  /// When true, start audiobook narration after the manuscript completes
  generateAudiobookOnComplete Boolean @default(false)
  /// Draw chapter-opener and scene pictures as chapters finish
  includeIllustrations Boolean  @default(false)
  /// Style line plus cast and place descriptors shared by every illustration prompt
  visualBible          Json?
  /// Refreshed by the running illustration job; stale means it can be resumed
  illustrationHeartbeatAt DateTime?

  /// Edition lineage — first book has edition 1; forks share parentBookId
  edition             Int     @default(1)
  parentBookId        String?
  parentBook          Book?   @relation("BookEditions", fields: [parentBookId], references: [id], onDelete: SetNull)
  editions            Book[]  @relation("BookEditions")

  /// Client that created the book: ios | android | web | unknown
  createdVia      String     @default("web")

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  completedAt     DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters        Chapter[]
  generationJobs  GenerationJob[]
  audios          BookAudio[]
  feedbacks       BookFeedback[]
  bible           BookBible?
  storyState      StoryState?
  canonFacts      CanonFact[]
  reels           StoryReel[]
  illustrations   BookIllustration[]

  @@index([userId])
  @@index([status])
  @@index([isPublic])
  @@index([parentBookId])
  @@index([createdVia])
}

/// Permanent canon layer (Book Bible) — authoritative vs manuscript prose.
model BookBible {
  id          String   @id @default(cuid())
  bookId      String   @unique
  /// Narrative style / voice notes
  styleNotes  String?  @db.Text
  /// World / magic / tech rules
  worldRules  String?  @db.Text
  themes      Json?
  /// Unresolved mysteries / open lore
  mysteries   Json?
  /// Extra structured canon bag
  meta        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  book        Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  characters  BibleCharacter[]
  locations   BibleLocation[]
  factions    BibleFaction[]
  objects     BibleObject[]
}

model BibleCharacter {
  id            String   @id @default(cuid())
  bibleId       String
  name          String
  aliases       Json?
  profile       String?  @db.Text
  relationships Json?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bible BookBible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@index([bibleId])
  @@index([bibleId, name])
}

model BibleLocation {
  id          String   @id @default(cuid())
  bibleId     String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bible BookBible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@index([bibleId])
  @@index([bibleId, name])
}

model BibleFaction {
  id          String   @id @default(cuid())
  bibleId     String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bible BookBible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@index([bibleId])
}

model BibleObject {
  id          String   @id @default(cuid())
  bibleId     String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bible BookBible @relation(fields: [bibleId], references: [id], onDelete: Cascade)

  @@index([bibleId])
}

/// Live plot / arc state for the whole book.
model StoryState {
  id             String   @id @default(cuid())
  bookId         String   @unique
  plotPhase      String?
  timelineCursor String?
  openThreads    Json?
  arcs           Json?
  partSummary    String?  @db.Text
  bookSummary    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

/// Explicit canon facts for consistency checking.
model CanonFact {
  id              String   @id @default(cuid())
  bookId          String
  subject         String
  predicate       String
  object          String   @db.Text
  /// CANON | PROVISIONAL | RETCONNED
  status          String   @default("CANON")
  sourceChapterId String?
  sourceSectionId String?
  confidence      Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([bookId, subject])
  @@index([bookId, status])
}

/// User review / complaint after generation (or manual report from book page)
model BookFeedback {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  /// 1–5 stars; null when it's a complaint-only report
  rating    Int?
  /// happy | ok | disappointed | complaint
  sentiment String
  /// completed | failed | manual
  trigger   String
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
  @@index([createdAt])
  @@index([sentiment])
}

model BookAudio {
  id           String                @id @default(cuid())
  bookId       String
  type         AudioDerivativeType
  status       AudioDerivativeStatus @default(PENDING)
  progress     Float                 @default(0)
  title        String?
  voiceId      String?
  voiceName    String?
  /// ElevenLabs voice_settings + modelId JSON
  voiceSettings Json?
  /// Full-track URL when a single file is produced (e.g. music theme)
  audioUrl     String?               @db.Text
  errorMessage String?               @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  completedAt  DateTime?

  book   Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tracks BookAudioTrack[]
  reels  StoryReel[]

  @@index([bookId])
  @@index([bookId, type])
  @@index([status])
}

model BookAudioTrack {
  id        String   @id @default(cuid())
  audioId   String
  number    Int
  title     String
  audioUrl  String   @db.Text
  chapterId String?
  durationMs Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audio BookAudio @relation(fields: [audioId], references: [id], onDelete: Cascade)

  @@unique([audioId, number])
  @@index([audioId])
}

/// Story Reel: vertical narrated video with one AI illustration per shot,
/// word-timed captions and mood music. Played live from its timeline.
model StoryReel {
  id            String     @id @default(cuid())
  bookId        String
  userId        String
  /// Visual Audiobook: the audiobook this reel illustrates
  audioId       String?
  format        ReelFormat
  status        ReelStatus @default(PENDING)
  progress      Float      @default(0)
  /// What the job is doing right now, for progress UI
  phase         String?
  title         String
  stylePreset   String     @default("cinematic")
  voiceId       String?
  voiceName     String?
  /// TTS settings, plus the background-music score under `music`
  voiceSettings Json?
  /// Style line plus cast and place descriptors shared by every shot prompt
  visualBible   Json?
  /// Narration seconds charged to the monthly reel allowance (an estimate until narrated)
  billedSeconds Int        @default(0)
  /// Unlisted share link: /r/[shareToken]
  shareToken    String?    @unique
  /// Refreshed by the running job; a stale heartbeat means it can be resumed
  heartbeatAt   DateTime?
  errorMessage  String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?
  /// Hidden from the user but kept, so its narration still counts against this month's allowance
  deletedAt     DateTime?

  book     Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  audio    BookAudio?    @relation(fields: [audioId], references: [id], onDelete: SetNull)
  episodes ReelEpisode[]

  @@index([bookId])
  @@index([userId, createdAt])
  @@index([status])
}

/// One playable video in a reel: a chapter Short, the trailer, or an audiobook track.
model ReelEpisode {
  id          String     @id @default(cuid())
  reelId      String
  number      Int
  title       String
  chapterId   String?
  status      ReelStatus @default(PENDING)
  /// Narration script; paragraphs separated by blank lines, single spaces
  script      String?    @db.Text
  audioUrl    String?    @db.Text
  durationMs  Int?
  /// Word timings for captions: [[word, startMs, endMs], ...]
  captions    Json?
  /// MP4 export: QUEUED | RENDERING | DONE | STALE | FAILED
  videoStatus String?
  videoUrl    String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  reel  StoryReel  @relation(fields: [reelId], references: [id], onDelete: Cascade)
  shots ReelShot[]

  @@unique([reelId, number])
  @@index([reelId])
}

/// One illustration and the stretch of narration it covers.
model ReelShot {
  id               String    @id @default(cuid())
  episodeId        String
  number           Int
  /// Narration this image covers
  text             String    @db.Text
  /// Character range of the episode script this shot covers
  charStart        Int
  charEnd          Int
  startMs          Int?
  endMs            Int?
  /// What the image shows, from the shot planner (no style or cast lines)
  description      String    @db.Text
  /// Full prompt last sent to the image model
  prompt           String?   @db.Text
  imageUrl         String?   @db.Text
  /// Image before the last re-roll, for undo
  previousImageUrl String?   @db.Text
  /// push-in | pull-out | pan-left | pan-right | rise
  motion           String    @default("push-in")
  mood             String    @default("neutral")
  /// Cast names in the shot
  characters       Json?
  /// PENDING | GENERATING | DONE | REUSED | FAILED
  status           String    @default("PENDING")
  attempts         Int       @default(0)
  rerolls          Int       @default(0)
  claimedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  episode ReelEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, number])
  @@index([episodeId])
}

model Chapter {
  id          String        @id @default(cuid())
  bookId      String
  number      Int
  title       String
  summary     String?       @db.Text
  content     String?       @db.Text
  pageCount   Int           @default(0)
  status      ChapterStatus @default(PENDING)
  /// Picture shown above the chapter title
  imageUrl    String?       @db.Text
  /// Set once the chapter's pictures are planned, drawn and placed
  illustratedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  book          Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sections      Section[]
  state         ChapterState?
  illustrations BookIllustration[]

  @@unique([bookId, number])
  @@index([bookId])
}

/// Compact chapter state for hierarchical context (~300–800 tokens).
model ChapterState {
  id                 String   @id @default(cuid())
  chapterId          String   @unique
  summary            String?  @db.Text
  charactersPresent  Json?
  location           String?
  events             Json?
  newFacts           Json?
  openThreads        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model Section {
  id          String   @id @default(cuid())
  chapterId   String
  number      Int
  title       String
  content     String?  @db.Text
  pageCount   Int      @default(0)
  wordCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  state       SectionState?

  @@unique([chapterId, number])
  @@index([chapterId])
}

/// Compact scene/section state for hierarchical context (~100–200 tokens).
model SectionState {
  id                String   @id @default(cuid())
  sectionId         String   @unique
  summary           String?  @db.Text
  objective         String?  @db.Text
  charactersPresent Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

/// A picture in a book: a chapter opener, or a scene placed after a paragraph.
model BookIllustration {
  id             String    @id @default(cuid())
  bookId         String
  chapterId      String
  /// OPENER | SCENE
  kind           String
  /// Order within the chapter; the opener is 0
  position       Int
  /// Section and prose paragraph (0-based) a scene goes after
  sectionId      String?
  paragraphIndex Int?
  /// What the picture shows, from the planner (no style or cast lines)
  description    String    @db.Text
  caption        String?   @db.Text
  /// Cast names in the picture
  characters     Json?
  mood           String    @default("neutral")
  /// Full prompt last sent to the image model
  prompt         String?   @db.Text
  imageUrl       String?   @db.Text
  /// PENDING | DRAWING | READY | FAILED
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  claimedAt      DateTime?
  error          String?   @db.Text
  /// Set when the picture is in the chapter (opener on the chapter, scene in the section text)
  placedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, kind, position])
  @@index([bookId, status])
}

model GenerationJob {
  id          String              @id @default(cuid())
  bookId      String
  type        String
  status      GenerationJobStatus @default(PENDING)
  payload     Json?
  result      Json?
  error       String?             @db.Text
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(3)
  /// Queue priority — higher value runs first (Enterprise > Pro > Free)
  priority    Int                 @default(1)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  book        Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([status, priority, createdAt])
}
